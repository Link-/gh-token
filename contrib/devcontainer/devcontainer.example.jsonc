// Example .devcontainer/devcontainer.json wiring up gh-token for a local
// agent. Copy contrib/devcontainer/*.sh into .devcontainer/gh-token/.
//
// On the host, before opening the container:
//   gh extension install Link-/gh-token
//   export GH_TOKEN_APP_ID=123456
//   export GH_TOKEN_KEY=$HOME/.config/gh-token/app.pem
{
  "name": "agent",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Runs on the HOST: starts the token refresher and waits for the first token.
  // ${devcontainerId} is unique per container and stable across rebuilds; the
  // same path is used as the mount source below.
  "initializeCommand": "bash .devcontainer/gh-token/host-init.sh \"${localEnv:HOME}/.cache/gh-token/${devcontainerId}\"",

  "mounts": [
    // Mount the directory, not the token file: atomic renames on the host are
    // only visible through a directory mount.
    "source=${localEnv:HOME}/.cache/gh-token/${devcontainerId},target=/run/gh-token,type=bind,readonly"
  ],

  // Runs in the container: installs the gh shim and git credential helper.
  "postCreateCommand": "bash .devcontainer/gh-token/post-create.sh",

  "customizations": {
    "codespaces": {
      // Additional repositories; the clone's own repository is implicit.
      "repositories": {
        "my-org/shared-charts": {
          "permissions": { "contents": "write", "pull_requests": "write" }
        }
      }
    },
    "gh-token": {
      // Permissions for the clone's own repository (from its "origin" remote).
      // They must equal the other repositories' permissions, because a token
      // carries one permission set; differing sets need --merge-permissions,
      // which widens access.
      "currentRepository": {
        "permissions": { "contents": "write", "pull_requests": "write" }
      }
    }
  }
}
